{
  "name": "fast-http-client",
  "version": "0.1.1",
  "description": "A small fetch-based HTTP client with retries, a circuit breaker, caching, interceptors and token refresh.",
  "keywords": [
    "http",
    "fetch",
    "client",
    "retry",
    "circuit-breaker",
    "cache",
    "interceptors"
  ],
  "license": "MIT",
  "homepage": "https://github.com/sajanv88/create-http/tree/main/packages/create-http#readme",
  "bugs": {
    "url": "https://github.com/sajanv88/create-http/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sajanv88/create-http.git",
    "directory": "packages/create-http"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsc --watch --preserveWatchOutput",
    "build": "tsc",
    "test": "node --test",
    "check-types": "tsc --noEmit && tsc -p test"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.4.1",
    "typescript": "7.0.2"
  }
}
