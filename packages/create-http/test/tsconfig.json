{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "..",
    // Node runs these files by stripping types, so type-only imports must say `import type`.
    "verbatimModuleSyntax": true,
    // Type-check against the source, so check-types doesn't need a build first.
    "paths": {
      "create-http": ["../src/index.mts"]
    }
  },
  "include": ["."]
}
